             self.trainset,
             batch_size=cfg.batch_size,
             shuffle=True,
-            num_workers=4,
-            persistent_workers=True,
+            # Windows 上 spawn 多进程 DataLoader 需要把整个 dataset（含每相机的
+            # 畸变矫正映射 mapx/mapy，数百相机时可达数 GB）pickle 进子进程管道，
+            # 超过 Windows 管道上限直接 EINVAL。单进程加载足够喂饱 GPU。
+            num_workers=4 if os.name != "nt" else 0,
