+def filter_blurry_frames(output_dir, blur_ratio=0.15, min_keep_ratio=0.7):
+    """丢弃严重运动模糊帧（拉普拉斯方差低于全体中位数的 blur_ratio 倍）。
+
+    快速甩动产生的模糊帧会拖低匹配与重建质量；但连续模糊段保留一帧
+    （避免 SfM 轨迹在转弯处断裂），且过滤后帧数低于 min_keep_ratio
+    时整体放弃过滤（保底，绝不把视频抽空）。
+    """
+    import statistics
+
+    import cv2
+
+    output_dir = os.path.join(output_dir, "") if not os.path.isdir(output_dir) else output_dir
+    files = sorted(
+        os.path.join(output_dir, name)
+        for name in os.listdir(output_dir)
+        if name.startswith("image_") and name.endswith(".png")
+    )
+    if len(files) < 8:
+        return len(files), 0
+    sharpness = []
+    for path in files:
+        image = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
+        if image is None:
+            sharpness.append(float("inf"))
+        else:
+            sharpness.append(float(cv2.Laplacian(image, cv2.CV_64F).var()))
+    threshold = statistics.median(sharpness) * blur_ratio
+    keep = [score >= threshold for score in sharpness]
+    # 连续模糊段保留一帧，保证轨迹在快速转动段仍可衔接
+    for index in range(1, len(keep) - 1):
+        if not keep[index - 1] and not keep[index] and keep[index + 1]:
+            keep[index] = True
+    if sum(keep) < len(files) * min_keep_ratio:
+        logger.info("blur filter skipped (too many frames below threshold)")
+        return len(files), 0
+    removed = 0
+    for path, should_keep in zip(files, keep):
+        if not should_keep:
+            os.remove(path)
+            removed += 1
+    logger.info(f"blur filter removed {removed}/{len(files)} frames")
+    return len(files) - removed, removed
 
 
