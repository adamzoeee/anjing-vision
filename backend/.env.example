ENVIRONMENT=development
DATABASE_URL=sqlite:///./anjing.db
# 生产环境必须替换为至少 32 字节的随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-use-env-32bytes
TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anjing
MINIO_SECURE=false
DATA_DIR=./data

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
TASK_SYNC=false
ALLOW_SYNC_FALLBACK=true

AUTO_CREATE_TABLES=true
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_UPLOAD_BYTES=536870912
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 正式 3D 重建主线（源码与独立 Conda 环境不得安装进 backend/.venv）。
VID2SCENE_ENABLED=true
# VID2SCENE_CORE_DIR=<部署目录>\vid2scene\vid2scene_core
# VID2SCENE_GSPLAT_SCRIPT=<部署目录>\vid2scene\gsplat\examples\simple_trainer.py
# VID2SCENE_PYTHON=<独立环境目录>\python.exe
VID2SCENE_FRAMECOUNT=300
VID2SCENE_TRAINING_STEPS=20000
VID2SCENE_MAX_GAUSSIANS=1200000
VID2SCENE_RECONSTRUCTION_METHOD=colmap

# 标准安龄智境 AprilTag 打印版的 detection-corner 边长为 0.09m。
APRILTAG_ENABLED=true
APRILTAG_FAMILY=tagStandard41h12
APRILTAG_SIZE_M=0.09

# 生产运行时必须显式覆盖以下值，禁止提交真实值：
# CORS_ORIGINS=["https://app.example.com"]
# ENVIRONMENT=production
# AUTO_CREATE_TABLES=false
# ALLOW_SYNC_FALLBACK=false
# MINIO_ACCESS_KEY=<non-default-access-key>
# MINIO_SECRET_KEY=<strong-random-secret-key>
