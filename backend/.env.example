ENVIRONMENT=development
DATABASE_URL=sqlite:///./anjing.db
# 生产环境必须替换为至少 32 字节的随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-use-env-32bytes
TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anjing
MINIO_SECURE=false
DATA_DIR=./data

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
TASK_SYNC=false
ALLOW_SYNC_FALLBACK=true

AUTO_CREATE_TABLES=true
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_UPLOAD_BYTES=536870912
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 正式 3D 重建主线：SLAM3R（稠密重建，独立 slam3r Conda 环境）
# 源码与独立环境不得安装进 backend/.venv。
# SLAM3R_DIR=E:\.PJs\slam3r
# SLAM3R_PYTHON=C:\Users\<you>\.conda\envs\slam3r\python.exe
# SLAM3R_I2P_WEIGHTS=E:\.PJs\models\slam3r_i2p\slam3r_i2p.pth
# SLAM3R_L2W_WEIGHTS=E:\.PJs\models\slam3r_l2w\slam3r_l2w.pth
SLAM3R_FPS=4
SLAM3R_KEYFRAME_STRIDE=3
SLAM3R_WIN_R=5
SLAM3R_NUM_SCENE_FRAME=10
SLAM3R_INITIAL_WINSIZE=5
SLAM3R_CONF_THRES_L2W=12
SLAM3R_CONF_THRES_I2P=1.5
SLAM3R_NUM_POINTS_SAVE=3000000
# 点云后处理：以层高恢复米制尺度（普通住宅 2.6~2.8m）
SLAM3R_TARGET_HEIGHT_M=2.6
PREVIEW_VOXEL_M=0.008
PREVIEW_MAX_POINTS=3000000
SPATIALLM_VOXEL_M=0.005

# SpatialLM 空间结构识别（独立 spatiallm Conda 环境）
# SPATIALLM_DIR=E:\.PJs\spatiallm
# SPATIALLM_PYTHON=C:\Users\<you>\.conda\envs\spatiallm\python.exe
# SPATIALLM_MODEL_PATH=E:\.PJs\models\SpatialLM1.1-Qwen-0.5B
# 家具类别白名单（逗号分隔，小写）；留空 = 仅用点云支撑密度过滤幻觉框
# SPATIALLM_OBJECT_WHITELIST=bed,table,chair,sofa,wardrobe,cupboard,cabinet,desk,refrigerator,toilet,sink,bathtub
# ffmpeg（默认探测 C:\ffmpeg\bin 与 PATH）
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe

# Gaussian 连续场景重建（独立 gsplat Conda 环境，需 CUDA 编译的 gsplat）
# GAUSSIAN_PYTHON=D:\conda\slam3r\python.exe
# GAUSSIAN_TRAIN_ITERS=8000

# 生产运行时必须显式覆盖以下值，禁止提交真实值：
# CORS_ORIGINS=["https://app.example.com"]
# ENVIRONMENT=production
# AUTO_CREATE_TABLES=false
# ALLOW_SYNC_FALLBACK=false
# MINIO_ACCESS_KEY=<non-default-access-key>
# MINIO_SECRET_KEY=<strong-random-secret-key>
