ENVIRONMENT=development
DATABASE_URL=sqlite:///./anjing.db
# 生产环境必须替换为至少 32 字节的随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-use-env-32bytes
TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anjing
MINIO_SECURE=false
DATA_DIR=./data

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
TASK_SYNC=false
ALLOW_SYNC_FALLBACK=true

AUTO_CREATE_TABLES=true
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_UPLOAD_BYTES=536870912
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
